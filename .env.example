# 오피넷 API 인증키 (필수 — 이게 없으면 서버가 주유소 검색을 못 합니다)
# 발급: https://www.opinet.co.kr (오피넷 Open API)
OPINET_CERTKEY=

# 한국조폐공사 지역화폐 가맹점 API 키
# 운영 서버(src/server.js)는 사용하지 않습니다.
# src/legacy/의 예전 스크립트를 직접 실행할 때만 필요합니다.
LOCALPAY_SERVICE_KEY=

# Kakao Developers > JavaScript key
KAKAO_JAVASCRIPT_KEY=

# Kakao Developers > REST API key (server-side address/place/reverse geocoding)
KAKAO_REST_API_KEY=

# 오피넷 하루 호출 상한(서버 메모리 안전장치, 기본 280). Render 재시작 시 카운터가 초기화되므로 실제 사용량과 완전히 동일하지 않을 수 있습니다.
OPINET_DAILY_LIMIT=280
